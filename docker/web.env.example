# moyu web (apps/web) runtime env — loaded via `env_file` in docker-compose.yml.
# Copy to docker/web.env.
#
# The image is built with production's values as its defaults (nuxt.config.ts
# `$production`); Nitro overrides any of them from its canonical NUXT_* name at
# container start, and an empty value counts. This local stack overrides the
# browser-facing URLs with host ports and blanks the production tracker.
# The NUXT_PUBLIC_* values are public, not secret — they ship to the browser.

NUXT_PUBLIC_API_BASE=http://localhost:15010/api/v1
NUXT_PUBLIC_OAUTH_SERVER_URL=http://localhost:15005/api/v1
NUXT_PUBLIC_OAUTH_WEB_URL=http://localhost:15008
NUXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:15011/auth/callback

# Empty host or id = no Umami script; empty AIFY URL = no AIEro banner.
NUXT_PUBLIC_UMAMI_HOST=
NUXT_PUBLIC_UMAMI_ID=
NUXT_PUBLIC_UMAMI_AIFY_URL=
