# moyu API (apps/api) runtime env — loaded via `env_file` in docker-compose.yml.
# Copy to docker/api.env and fill the secrets. NEVER commit the real file
# (.dockerignore + .gitignore keep docker/*.env out of images and git).
#
# KUN_SERVER_MODE=prod gives the production defaults (pkg/config.Load): infra
# service names on the shared network (oauth:9277, catalog:9281, image:9278,
# artifact:9279, community, trust, chat, redis) and moyu's OAuth client id. This
# file overrides only what differs on a local stack — the browser-facing host
# ports — plus the secrets. /admin/setting (环境变量与密钥) lists what the
# running API read and names any variable in its environment nothing reads.

KUN_SERVER_MODE=prod

# Shared Postgres (infra). Database kungalgame_patch must exist — add it to the
# infra's docker/initdb.d (CREATE DATABASE kungalgame_patch;).
KUN_DATABASE_URL=postgresql://postgres:191007@postgres:5432/kungalgame_patch?sslmode=disable
# Config store key (`openssl rand -base64 32`); unset leaves the store off and
# the secrets below must then be set here.
# KUN_CONFIG_KEK=

# Secrets. image, artifact, community and trust authenticate moyu with the
# OAuth client pair, so they take no credentials of their own.
OAUTH_CLIENT_SECRET=__SET_ME__
KUN_NEXTMOE_API_KEY=__SET_ME__

# Browser-facing host ports of this local stack.
OAUTH_REDIRECT_URI=http://localhost:15011/auth/callback
CORS_ALLOW_ORIGINS=http://localhost:15011
# MUST equal the public URL the frontend resolves image hashes against — see
# docker/README.md §image_service.
KUN_IMAGE_CDN_BASE=http://localhost:15002/kun-images
